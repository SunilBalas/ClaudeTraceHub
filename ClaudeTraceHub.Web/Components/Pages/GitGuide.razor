    private string CmdCfgName()
    {
        var g = _cfgNameGlobal ? "--global " : "";
        return $"git config {g}user.name \"{(_cfgName.Length == 0 ? "FIRST_NAME LAST_NAME" : _cfgName)}\"";
    }

    private string CmdCfgEmail()
    {
        var g = _cfgEmailGlobal ? "--global " : "";
        return $"git config {g}user.email \"{(_cfgEmail.Length == 0 ? "name@example.com" : _cfgEmail)}\"";
    }

    private static string Quote(string text)
    {
        if (string.IsNullOrEmpty(text)) return "\"\"";
        return text.Any(char.IsWhiteSpace) ? $"\"{text}\"" : text;
    }

    private void OnTabChanged(int idx)
    {
        _activeTab = idx;
        // Clear search when switching tabs so user sees the full section
        if (!string.IsNullOrEmpty(_search))
            _search = "";
    }

    private void OnSearchChanged(string value)
    {
        _search = value ?? "";
    }

    private void OnRebaseModeChanged(string mode)
    {
        _rebaseMode = mode ?? "interactive";
    }
