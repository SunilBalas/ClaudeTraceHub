@page "/git-guide"
@rendermode InteractiveServer
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Git Guide - Claude TraceHub</PageTitle>

<div class="page-content git-guide">

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4">Git Interactive Guide</MudText>
            <MudText Typo="Typo.body2" Color="Color.Tertiary">Quick command reference — fill in the inputs and copy the commands you need.</MudText>
        </div>
    </div>

    <MudPaper Elevation="2" Class="pa-3 mb-4" Style="border-radius: 12px;">
        <MudTextField T="string" Value="@_search" ValueChanged="OnSearchChanged"
                      Placeholder="Search commands (e.g. squash, amend, stash pop)..."
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Immediate="true" DebounceInterval="150" />
    </MudPaper>

    <MudTabs Position="Position.Left" Rounded="true" Border="true" Outlined="false"
             ApplyEffectsToContainer="true" PanelClass="pa-4" Class="git-guide-tabs"
             ActivePanelIndex="_activeTab" ActivePanelIndexChanged="OnTabChanged">

        @* ============ SETUP ============ *@
        <MudTabPanel Text="Setup" Icon="@Icons.Material.Filled.Settings">
            @if (_search.Length == 0) { <SectionHeader Title="Setup" Desc="Configure your Git identity before committing." /> }

            <GuideCard Title="Set Git user name" Desc="The name attached to every commit you make."
                       SearchTags="config user name identity who am i author" Search="@_search">
                <MudGrid>
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_cfgName" Label="Full name" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center">
                        <MudCheckBox @bind-Value="_cfgNameGlobal" Label="--global" Color="Color.Primary" Dense="true" Size="Size.Small" />
                    </MudItem>
                </MudGrid>
                <CmdBlock Command="@CmdCfgName()" />
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Tip:</b> Use <code>--global</code> for every repo on this machine. Omit it to set per-repo.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Set Git user email" Desc="The email attached to every commit."
                       SearchTags="config user email identity author" Search="@_search">
                <MudGrid>
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_cfgEmail" Label="Email" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center">
                        <MudCheckBox @bind-Value="_cfgEmailGlobal" Label="--global" Color="Color.Primary" Dense="true" Size="Size.Small" />
                    </MudItem>
                </MudGrid>
                <CmdBlock Command="@CmdCfgEmail()" />
            </GuideCard>

            <GuideCard Title="View current config" Desc="Show all effective Git settings (local + global)."
                       SearchTags="config list view settings" Search="@_search">
                <CmdBlock Command="git config --list" />
            </GuideCard>
        </MudTabPanel>

        @* ============ STATUS ============ *@
        <MudTabPanel Text="Status" Icon="@Icons.Material.Filled.FactCheck">
            @if (_search.Length == 0) { <SectionHeader Title="Status" Desc="Inspect what has changed and what is committed." /> }

            <GuideCard Title="See all changes" Desc="Show staged, unstaged, and untracked files."
                       SearchTags="status changes see modified untracked" Search="@_search">
                <CmdBlock Command="git status" />
            </GuideCard>

            <GuideCard Title="Short status" Desc="Compact one-line-per-file view."
                       SearchTags="status short compact" Search="@_search">
                <CmdBlock Command="git status -s" />
            </GuideCard>

            <GuideCard Title="Recent commits" Desc="Last N commits as a compact list."
                       SearchTags="log history recent commits oneline" Search="@_search">
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="_logN" Label="How many?" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Min="1" Max="200" Immediate="true" />
                    </MudItem>
                </MudGrid>
                <CmdBlock Command="@($"git log --oneline -{_logN}")" />
            </GuideCard>
        </MudTabPanel>

        @* ============ STAGE ============ *@
        <MudTabPanel Text="Stage" Icon="@Icons.Material.Filled.AddCircleOutline">
            @if (_search.Length == 0) { <SectionHeader Title="Stage" Desc="Add changes to the staging area for the next commit." /> }

            <GuideCard Title="Stage all changes" Desc="Add every modified and untracked file to the next commit."
                       SearchTags="stage add all everything" Search="@_search">
                <CmdBlock Command="git add ." />
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Caution:</b> Also stages files like <code>.env</code> or build artifacts if not gitignored. Review <code>git status</code> first.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Stage a specific file" Desc="Add only the path you specify."
                       SearchTags="stage add specific file path" Search="@_search">
                <MudTextField @bind-Value="_addFile" Label="File path" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@($"git add {Quote(_addFile)}")" />
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Tip:</b> Paths with spaces are quoted automatically.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Stage interactively (hunk-by-hunk)" Desc="Pick specific lines/hunks within a file to stage."
                       SearchTags="stage interactive patch hunk partial" Search="@_search">
                <CmdBlock Command="git add -p" />
            </GuideCard>
        </MudTabPanel>

        @* ============ UNSTAGE ============ *@
        <MudTabPanel Text="Unstage" Icon="@Icons.Material.Filled.RemoveCircleOutline">
            @if (_search.Length == 0) { <SectionHeader Title="Unstage" Desc="Move changes out of staging without losing edits." /> }

            <GuideCard Title="Unstage all changes" Desc="Move every staged change back to the working tree (does NOT delete the changes)."
                       SearchTags="unstage reset all everything" Search="@_search">
                <CmdBlock Command="git reset ." />
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Modern alias:</b> <code>git restore --staged .</code> does the same.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Unstage a specific file" Desc="Pull one file out of the staging area."
                       SearchTags="unstage reset file specific path" Search="@_search">
                <MudTextField @bind-Value="_unstageFile" Label="File path" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@($"git reset {Quote(_unstageFile)}")" />
                <CmdBlock Command="@($"git restore --staged {Quote(_unstageFile)}")" Variant="ok" />
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Equivalent:</b> <code>git restore --staged</code> is the newer recommended form (Git 2.23+).
                </MudAlert>
            </GuideCard>
        </MudTabPanel>

        @* ============ DISCARD ============ *@
        <MudTabPanel Text="Discard" Icon="@Icons.Material.Filled.DeleteSweep">
            @if (_search.Length == 0) { <SectionHeader Title="Discard" Desc="Throw away local edits and reset files to committed state." /> }

            <GuideCard Title="Discard changes in a file" Desc="Throw away unstaged edits and restore the file to its last committed state."
                       Pill="destructive" PillColor="Color.Error"
                       SearchTags="discard restore working tree revert local" Search="@_search">
                <MudTextField @bind-Value="_discardFile" Label="File path" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@($"git restore {Quote(_discardFile)}")" Variant="danger" />
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Warning:</b> Unrecoverable. Consider <code>git stash</code> first if you might want them back.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Discard ALL local changes" Desc="Reset every modified file to its committed state. Untracked files are not touched."
                       Pill="destructive" PillColor="Color.Error"
                       SearchTags="discard all everything reset hard" Search="@_search">
                <CmdBlock Command="git restore ." Variant="danger" />
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Big hammer:</b> Use carefully. To also remove untracked files, use <code>git clean -fd</code> (irreversible too).
                </MudAlert>
            </GuideCard>
        </MudTabPanel>

        @* ============ STASH ============ *@
        <MudTabPanel Text="Stash" Icon="@Icons.Material.Filled.Inventory2">
            @if (_search.Length == 0) { <SectionHeader Title="Stash" Desc="Shelf work-in-progress so you can switch tasks." /> }

            <GuideCard Title="Stash current changes" Desc="Shelf your work-in-progress so you can switch tasks cleanly."
                       SearchTags="stash save shelf temporary" Search="@_search">
                <MudTextField @bind-Value="_stashMsg" Label="Optional message" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@(string.IsNullOrWhiteSpace(_stashMsg) ? "git stash" : $"git stash push -m \"{_stashMsg}\"")" />
            </GuideCard>

            <GuideCard Title="List all stashes" Desc="See every stash, newest first."
                       SearchTags="stash list show all view" Search="@_search">
                <CmdBlock Command="git stash list" />
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Output format:</b> <code>stash@@&#123;0&#125;: WIP on branch...</code> — the number in <code>&#123;&#125;</code> is the stash index.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Apply a stash & remove it from the list" Desc="Re-apply the stashed changes and drop the entry. Use the index from git stash list."
                       SearchTags="stash apply pop restore index" Search="@_search">
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="_stashIdx" Label="Stash index" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Min="0" Max="50" Immediate="true" />
                    </MudItem>
                </MudGrid>
                <CmdBlock Command="@($"git stash pop --index {_stashIdx}")" />
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Keep the stash?</b> Use <code>git stash apply --index N</code> instead — same result, but the entry stays in the list.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Drop a specific stash" Desc="Permanently delete a stash entry without applying it."
                       Pill="destructive" PillColor="Color.Error"
                       SearchTags="stash drop delete remove" Search="@_search">
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="_stashDropIdx" Label="Stash index" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Min="0" Max="50" Immediate="true" />
                    </MudItem>
                </MudGrid>
                <CmdBlock Command="@($"git stash drop stash@{{{_stashDropIdx}}}")" Variant="danger" />
            </GuideCard>
        </MudTabPanel>

        @* ============ COMMIT ============ *@
        <MudTabPanel Text="Commit" Icon="@Icons.Material.Filled.Check">
            @if (_search.Length == 0) { <SectionHeader Title="Commit" Desc="Save staged changes; amend the most recent commit." /> }

            <GuideCard Title="Commit staged changes" Desc="Create a commit from everything currently staged."
                       SearchTags="commit staged changes message" Search="@_search">
                <MudTextField @bind-Value="_commitMsg" Label="Commit message" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@($"git commit -m \"{(_commitMsg.Length == 0 ? "commit message" : _commitMsg)}\"")" />
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Project convention:</b> <code>[Area] : [WorkItemID] : [Description]</code>.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Amend the last commit message" Desc="Rewrite the message of the most recent commit (not pushed yet)."
                       SearchTags="commit amend fix last message change reword" Search="@_search">
                <MudTextField @bind-Value="_amendMsg" Label="Corrected message" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@($"git commit --amend -m \"{(_amendMsg.Length == 0 ? "corrected message" : _amendMsg)}\"")" Variant="warn" />
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>If already pushed:</b> a force-push is required afterwards (<code>git push -f</code>). Avoid on shared branches.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Amend without changing the message" Desc="Add freshly-staged changes to the last commit, keeping its message."
                       SearchTags="commit amend no edit keep message add files" Search="@_search">
                <CmdBlock Command="git commit --amend --no-edit" Variant="warn" />
            </GuideCard>
        </MudTabPanel>

        @* ============ PUSH / PULL ============ *@
        <MudTabPanel Text="Push / Pull" Icon="@Icons.Material.Filled.SyncAlt">
            @if (_search.Length == 0) { <SectionHeader Title="Push / Pull" Desc="Sync with the remote branch." /> }

            <GuideCard Title="Pull latest changes" Desc="Fetch and merge updates from the tracked remote branch."
                       SearchTags="pull fetch update remote" Search="@_search">
                <CmdBlock Command="git pull" />
            </GuideCard>

            <GuideCard Title="Push commits" Desc="Send local commits to the tracked remote branch."
                       SearchTags="push upload commits" Search="@_search">
                <CmdBlock Command="git push" />
            </GuideCard>

            <GuideCard Title="Force push" Desc="Overwrite the remote branch — required after rebasing or amending."
                       Pill="danger" PillColor="Color.Error"
                       SearchTags="push force rebase rewrite history" Search="@_search">
                <CmdBlock Command="git push -f" Variant="danger" />
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Important:</b> You must have force-push permission. Never force-push to <code>master</code> / <code>main</code> without team approval.
                </MudAlert>
                <CmdBlock Command="git push --force-with-lease" Variant="ok" />
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Safer:</b> <code>--force-with-lease</code> refuses to overwrite if someone else pushed in the meantime.
                </MudAlert>
            </GuideCard>
        </MudTabPanel>

        @* ============ REBASE ============ *@
        <MudTabPanel Text="Rebase" Icon="@Icons.Material.Filled.Loop">
            @if (_search.Length == 0) { <SectionHeader Title="Rebase" Desc="Replay commits on top of another branch." /> }

            <MudPaper Elevation="0" Class="pa-2 mb-3" Style="border-radius: 8px; background: var(--mud-palette-background-grey);">
                <MudToggleGroup T="string" SelectionMode="SelectionMode.SingleSelection"
                                Value="_rebaseMode" ValueChanged="OnRebaseModeChanged"
                                Color="Color.Primary" Size="Size.Small">
                    <MudToggleItem Value="@("interactive")" Text="Interactive (-i)" />
                    <MudToggleItem Value="@("recursive")" Text="Recursive (default)" />
                </MudToggleGroup>
            </MudPaper>

            <GuideCard Title="Step 1 — Pull latest first" Desc="Always sync your branch before rebasing."
                       SearchTags="rebase pull update" Search="@_search">
                <CmdBlock Command="git pull" />
            </GuideCard>

            <GuideCard Title="Step 2 — Rebase onto target branch" Desc="Replay your commits on top of the chosen base branch."
                       SearchTags="rebase target branch interactive recursive" Search="@_search">
                <MudTextField @bind-Value="_rebaseBranch" Label="Target branch" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@($"git rebase {(_rebaseMode == "interactive" ? "-i " : "")}{_rebaseBranch}")" />
                @if (_rebaseMode == "interactive")
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                        <b>Editor:</b> when the TODO list opens, press <kbd>ESC</kbd>, then type <code>:wq</code> + <kbd>Enter</kbd>.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                        <b>No editor in recursive mode</b> unless there is a conflict that needs message editing.
                    </MudAlert>
                }
            </GuideCard>

            <GuideCard Title="Step 3a — Continue after resolving conflicts" Desc="After staging the resolved files (git add <file>):"
                       SearchTags="rebase continue resolve conflict" Search="@_search">
                <CmdBlock Command="git rebase --continue" />
            </GuideCard>

            <GuideCard Title="Step 3b — Abort the rebase" Desc="Roll back to the state before the rebase started."
                       SearchTags="rebase abort cancel stop" Search="@_search">
                <CmdBlock Command="git rebase --abort" Variant="danger" />
            </GuideCard>

            <GuideCard Title="Step 4 — Force-push the rebased branch" Desc="Rewriting history requires a force push to update the remote."
                       SearchTags="rebase force push" Search="@_search">
                <CmdBlock Command="git push -f" Variant="danger" />
            </GuideCard>
        </MudTabPanel>

        @* ============ SQUASH ============ *@
        <MudTabPanel Text="Squash" Icon="@Icons.Material.Filled.Compress">
            @if (_search.Length == 0) { <SectionHeader Title="Squash" Desc="Combine multiple commits into a single commit." /> }

            <GuideCard Title="Squash the last N commits into one" Desc="Compact a series of WIP commits into a single clean commit before raising a PR."
                       SearchTags="squash combine merge commits into one" Search="@_search">
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="_squashN" Label="Number of commits (N)" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Min="2" Max="500" Immediate="true" />
                    </MudItem>
                </MudGrid>
                <CmdBlock Command="@($"git rebase -i HEAD~{_squashN}")" />

                <div class="step-row mt-3">
                    <div class="step-num">1</div>
                    <div class="step-text">Run the command above — an editor opens with the last <b>@_squashN</b> commits, each line prefixed with <code>pick</code>.</div>
                </div>
                <div class="step-row">
                    <div class="step-num">2</div>
                    <div class="step-text">Keep the <b>first</b> line as <code>pick</code>. Change every other line from <code>pick</code> to <code>squash</code> (or <code>s</code>).</div>
                </div>

                <pre class="todo-list"><span class="todo-pick">pick</span>   <span class="todo-hash">a1b2c3d</span> First commit (kept as base)
<span class="todo-squash">squash</span> <span class="todo-hash">e4f5g6h</span> Second commit  &larr; was "pick"
<span class="todo-squash">squash</span> <span class="todo-hash">i7j8k9l</span> Third commit   &larr; was "pick"
<span class="todo-squash">squash</span> <span class="todo-hash">m0n1o2p</span> ...
<span class="todo-squash">squash</span> <span class="todo-hash">q3r4s5t</span> Nth commit     &larr; was "pick"</pre>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Vim bulk replace:</b> <code>:2,$s/^pick/squash/</code> changes every <code>pick</code> after line 1 to <code>squash</code> in one shot.
                </MudAlert>
                <div class="step-row mt-3">
                    <div class="step-num">3</div>
                    <div class="step-text">Save &amp; exit: <kbd>ESC</kbd> &rarr; <code>:wq</code> &rarr; <kbd>Enter</kbd>.</div>
                </div>
                <div class="step-row">
                    <div class="step-num">4</div>
                    <div class="step-text">A second editor opens with all N commit messages combined — edit it down to one clean message.</div>
                </div>
                <div class="step-row">
                    <div class="step-num">5</div>
                    <div class="step-text">Verify with <code>git log --oneline -5</code>.</div>
                </div>
                <div class="step-row">
                    <div class="step-num">6</div>
                    <div class="step-text">Force-push to update the remote: <code>git push -f</code>.</div>
                </div>

                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    <b>If something looks wrong:</b> quit Vim without saving (<code>:q!</code>) or run <code>git rebase --abort</code> after a bad save.
                </MudAlert>
            </GuideCard>
        </MudTabPanel>

        @* ============ CHERRY-PICK ============ *@
        <MudTabPanel Text="Cherry-pick" Icon="@Icons.Material.Filled.ContentPaste">
            @if (_search.Length == 0) { <SectionHeader Title="Cherry-pick" Desc="Apply a single commit from another branch." /> }

            <GuideCard Title="Cherry-pick a commit" Desc="Apply a single commit from another branch onto the current one."
                       SearchTags="cherry pick commit apply specific" Search="@_search">
                <MudTextField @bind-Value="_cherryId" Label="Commit hash" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@($"git cherry-pick {(_cherryId.Length == 0 ? "<commit>" : _cherryId)}")" />
            </GuideCard>

            <GuideCard Title="Cherry-pick from a merge commit" Desc="Merge commits have multiple parents — tell Git which parent to use as the mainline."
                       Pill="advanced" PillColor="Color.Secondary"
                       SearchTags="cherry pick merge commit parent mainline" Search="@_search">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_cherryMergeId" Label="Commit hash" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_cherryParent" Label="Parent number" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Min="1" Max="9" Immediate="true" />
                    </MudItem>
                </MudGrid>
                <CmdBlock Command="@($"git cherry-pick -m {_cherryParent} {(_cherryMergeId.Length == 0 ? "<commit>" : _cherryMergeId)}")" Variant="purple" />
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Parent number:</b> <code>1</code> = the branch you merged INTO; <code>2</code> = the branch you merged FROM. Usually you want <code>1</code>.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Continue after resolving conflicts" Desc="After staging the resolved files:"
                       SearchTags="cherry pick continue conflict" Search="@_search">
                <CmdBlock Command="git cherry-pick --continue" />
            </GuideCard>

            <GuideCard Title="Abort the cherry-pick" Desc="Bail out and return the working tree to where it was."
                       SearchTags="cherry pick abort cancel" Search="@_search">
                <CmdBlock Command="git cherry-pick --abort" Variant="danger" />
            </GuideCard>
        </MudTabPanel>

        @* ============ REVERT ============ *@
        <MudTabPanel Text="Revert" Icon="@Icons.Material.Filled.Undo">
            @if (_search.Length == 0) { <SectionHeader Title="Revert" Desc="Create a new commit that undoes a previous one." /> }

            <GuideCard Title="Revert a commit" Desc="Create a NEW commit that undoes the changes of the specified commit. History is preserved."
                       SearchTags="revert undo commit create new" Search="@_search">
                <MudTextField @bind-Value="_revertId" Label="Commit hash" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@($"git revert {(_revertId.Length == 0 ? "<commit>" : _revertId)}")" />
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Revert vs reset:</b> revert is safe for shared branches (it just adds a new commit). Reset rewrites history and needs force-push.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Revert a merge commit" Desc="Reverting a merge requires specifying which parent to keep as the mainline."
                       Pill="advanced" PillColor="Color.Secondary"
                       SearchTags="revert merge commit parent mainline" Search="@_search">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_revertMergeId" Label="Merge commit hash" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_revertParent" Label="Parent number" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Min="1" Max="9" Immediate="true" />
                    </MudItem>
                </MudGrid>
                <CmdBlock Command="@($"git revert -m {_revertParent} {(_revertMergeId.Length == 0 ? "<commit>" : _revertMergeId)}")" Variant="warn" />
            </GuideCard>
        </MudTabPanel>

        @* ============ BRANCH ============ *@
        <MudTabPanel Text="Branch" Icon="@Icons.Material.Filled.CallSplit">
            @if (_search.Length == 0) { <SectionHeader Title="Branch" Desc="List, create, switch, and delete branches." /> }

            <GuideCard Title="List branches" Desc="All local and remote-tracking branches."
                       SearchTags="branch list show all" Search="@_search">
                <CmdBlock Command="git branch -a" />
            </GuideCard>

            <GuideCard Title="Create & switch to a new branch" Desc="Branch off the current HEAD."
                       SearchTags="branch new create checkout switch" Search="@_search">
                <MudTextField @bind-Value="_newBranch" Label="New branch name" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@($"git checkout -b {(_newBranch.Length == 0 ? "<branch>" : _newBranch)}")" />
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Convention:</b> <code>[team]/[PI_period]/[WorkItemID]_[description]</code>.
                </MudAlert>
            </GuideCard>

            <GuideCard Title="Switch branch" Desc="Check out an existing branch."
                       SearchTags="branch switch checkout move" Search="@_search">
                <MudTextField @bind-Value="_switchBranch" Label="Branch name" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@($"git checkout {(_switchBranch.Length == 0 ? "<branch>" : _switchBranch)}")" />
            </GuideCard>

            <GuideCard Title="Delete a local branch" Desc="Force-delete a branch even if not fully merged."
                       Pill="destructive" PillColor="Color.Error"
                       SearchTags="branch delete remove local" Search="@_search">
                <MudTextField @bind-Value="_delBranch" Label="Branch name" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" />
                <CmdBlock Command="@($"git branch -D {(_delBranch.Length == 0 ? "<branch>" : _delBranch)}")" Variant="danger" />
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    <b>Safer:</b> use lowercase <code>-d</code> to refuse deletion when the branch has unmerged commits.
                </MudAlert>
            </GuideCard>
        </MudTabPanel>

    </MudTabs>
</div>

