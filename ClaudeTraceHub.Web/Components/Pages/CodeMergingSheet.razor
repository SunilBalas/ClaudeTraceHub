@page "/code-merging"
@rendermode InteractiveServer
@inject CodeMergingService MergingService
@inject AzureDevOpsService DevOpsService
@inject AiAdoptionService AdoptionService
@inject IOptionsSnapshot<AzureDevOpsSettings> AzureSettings
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@using ClaudeTraceHub.Web.Models
@using ClaudeTraceHub.Web.Services
@using Microsoft.Extensions.Options
@using ClosedXML.Excel

<PageTitle>Code Merging Sheet - Claude TraceHub</PageTitle>

@if (!MergingService.IsConfigured)
{
    <div class="page-content">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
            Azure DevOps is not configured. Go to <MudLink Href="/settings" Color="Color.Inherit"><b>Settings</b></MudLink> to set up your connection.
        </MudAlert>
    </div>
}
else
{
    <div class="page-content">

    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">Code Merging Sheet</MudText>
        @if (_bundle.Requirements.Count > 0 && !_loading)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="ExportToExcel">Export Excel</MudButton>
        }
    </div>

    @* Filters *@
    <MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-radius: 12px;">
        <MudGrid>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string" Value="_selectedProject" ValueChanged="OnProjectChanged"
                           Label="Project" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Folder">
                    @foreach (var p in _projects)
                    {
                        <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string" Value="_selectedTeam" ValueChanged="OnTeamChanged"
                           Label="Team" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Disabled="@(_teams.Count == 0)"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Groups">
                    @{
                        var myTeamsList = _teams.Where(t => _myTeams.Contains(t)).ToList();
                        var otherTeamsList = _teams.Where(t => !_myTeams.Contains(t)).ToList();
                    }
                    @if (myTeamsList.Any())
                    {
                        <MudSelectItem T="string" Value="@("")" Disabled="true">
                            <MudText Typo="Typo.overline" Color="Color.Primary">My Teams</MudText>
                        </MudSelectItem>
                        @foreach (var t in myTeamsList)
                        {
                            <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                        }
                    }
                    @if (myTeamsList.Any() && otherTeamsList.Any())
                    {
                        <MudSelectItem T="string" Value="@("__divider__")" Disabled="true">
                            <MudText Typo="Typo.overline" Color="Color.Default">Other Teams</MudText>
                        </MudSelectItem>
                    }
                    @foreach (var t in otherTeamsList)
                    {
                        <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string" Value="_currentIterationPath" ValueChanged="OnIterationChanged"
                           Label="Iteration" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Disabled="@(_iterations.Count == 0)"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Replay">
                    @foreach (var iter in _iterations)
                    {
                        <MudSelectItem T="string" Value="@iter">@TruncateIteration(iter)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string" Label="Repositories" MultiSelection="true" Variant="Variant.Outlined"
                           Margin="Margin.Dense" SelectedValues="_selectedRepos"
                           SelectedValuesChanged="OnReposChanged"
                           Disabled="@(_repos.Count == 0)"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Source"
                           MultiSelectionTextFunc="@(new Func<List<string>, string>(sel => $"{sel.Count} repo(s)"))">
                    @foreach (var repo in _repos)
                    {
                        <MudSelectItem T="string" Value="@repo.Name">@repo.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3" md="1" Class="d-flex align-center">
                <MudCheckBox @bind-Value="_deliverableOnly" Label="Deliverable" Color="Color.Primary"
                             Dense="true" Size="Size.Small" />
            </MudItem>
            <MudItem xs="12" sm="3" md="2" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@(_loading ? "" : Icons.Material.Filled.Sync)"
                           OnClick="LoadData"
                           Disabled="@(string.IsNullOrEmpty(_currentIterationPath) || _loading)"
                           FullWidth="true">
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                        <text>Loading...</text>
                    }
                    else
                    {
                        <text>Load Data</text>
                    }
                </MudButton>
            </MudItem>
        </MudGrid>

        @* Target Branch Verification Row *@
        @if (_bundle.Requirements.Count > 0)
        {
            <MudGrid Class="mt-2">
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Value="_selectedMember" ValueChanged="OnMemberChanged"
                               Label="Member (Assigned To)" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Clearable="true"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person">
                        <MudSelectItem T="string" Value="@("")">All Members</MudSelectItem>
                        @foreach (var m in _bundle.Requirements.Select(r => r.AssignedTo).Distinct().OrderBy(n => n))
                        {
                            <MudSelectItem T="string" Value="@m">@m</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Value="_selectedCreatedBy" ValueChanged="OnCreatedByChanged"
                               Label="Created By (PR Author)" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Clearable="true"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AccountCircle">
                        <MudSelectItem T="string" Value="@("")">All Creators</MudSelectItem>
                        @foreach (var c in AllPrCreators)
                        {
                            <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudAutocomplete T="string" Value="_targetBranch"
                                     ValueChanged="OnTargetBranchChanged"
                                     SearchFunc="SearchBranches"
                                     Label="Target Branch (for merge verification)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Placeholder="Search branch… e.g. main, release/prod"
                                     Clearable="true" Dense="true" MaxItems="50"
                                     CoerceText="true" CoerceValue="true"
                                     ResetValueOnEmptyText="false"
                                     ShowProgressIndicator="true"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.CallMerge" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2" Class="d-flex align-end">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                               StartIcon="@(_verifying ? "" : Icons.Material.Filled.VerifiedUser)"
                               OnClick="VerifyMerge"
                               Disabled="@(string.IsNullOrEmpty(_targetBranch) || _verifying)"
                               FullWidth="true">
                        @if (_verifying)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            <text>Verifying...</text>
                        }
                        else
                        {
                            <text>Verify All</text>
                        }
                    </MudButton>
                </MudItem>
                @if (!string.IsNullOrEmpty(_bundle.TargetBranchName))
                {
                    <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                            @_bundle.MergedToTargetCount merged
                        </MudChip>
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Cancel" Class="ml-1">
                            @_bundle.NotMergedToTargetCount not merged
                        </MudChip>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudPaper>

    @* Loading State *@
    @if (_loading)
    {
        <div class="d-flex align-center justify-center pa-8 gap-2">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Tertiary">Fetching requirements and PRs...</MudText>
        </div>
    }

    @* Error *@
    @if (!string.IsNullOrEmpty(_bundle.ErrorMessage) && !_loading)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">@_bundle.ErrorMessage</MudAlert>
    }

    @* Summary Cards *@
    @if (_bundle.Requirements.Count > 0 && !_loading)
    {
        var filtered = FilteredRequirements();
        <MudGrid Class="mb-4">
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius: 12px;">
                    <MudText Typo="Typo.overline" Color="Color.Tertiary">Requirements</MudText>
                    <MudText Typo="Typo.h4">@filtered.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius: 12px;">
                    <MudText Typo="Typo.overline" Color="Color.Tertiary">Total PRs</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Primary">@filtered.Sum(r => VisiblePrs(r).Count)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius: 12px;">
                    <MudText Typo="Typo.overline" Color="Color.Tertiary">Total Commits</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Info">@filtered.Sum(r => VisiblePrs(r).Sum(p => p.Commits.Count))</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius: 12px;">
                    <MudText Typo="Typo.overline" Color="Color.Tertiary">With PRs</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Success">
                        @filtered.Count(r => VisiblePrs(r).Count > 0) / @filtered.Count
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @* Main Data Grid — resizable, reorderable, with Excel-style multi-select filters per column.
           Click a row to auto-refresh its merge status against the target branch. *@
        @* Per-column sort/filter icons are intentionally disabled so headers stay text-only and
           column widths size to their data — keeping requirement/bug/CR titles fully readable.
           Columns remain manually resizable; use the Member filter above the grid to narrow rows. *@
        <MudDataGrid T="RequirementMergingRow" Items="@filtered"
                     Dense="true" Hover="true" Bordered="false"
                     ColumnResizeMode="ResizeMode.Column"
                     DragDropColumnReordering="false"
                     Filterable="false"
                     SortMode="SortMode.None"
                     Hideable="false"
                     Groupable="false"
                     ShowColumnOptions="false"
                     ShowMenuIcon="false"
                     RowsPerPage="100"
                     RowClick="OnRowClick"
                     Class="merging-grid mb-4" Elevation="2" Style="border-radius: 12px;">
            <ToolBarContent>
                <MudText Typo="Typo.subtitle1" Class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.TableRows" Size="Size.Small" />
                    Requirements
                </MudText>
                <MudSpacer />
                <MudTooltip Text="Order requirements by the date/time of their earliest commit (oldest first). Items without commits move to the end.">
                    <MudCheckBox T="bool" @bind-Value="_orderByFirstCommit"
                                 Label="Commit-wise" Color="Color.Primary"
                                 Dense="true" Size="Size.Small" Class="mr-2" />
                </MudTooltip>
                @if (!string.IsNullOrEmpty(_bundle.TargetBranchName))
                {
                    <MudTooltip Text="Click any row to refresh its merge status against the target branch.">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                 Icon="@Icons.Material.Filled.AutoMode">
                            Auto-refresh on row click
                        </MudChip>
                    </MudTooltip>
                }
            </ToolBarContent>
            <Columns>
                <HierarchyColumn T="RequirementMergingRow"
                                 ButtonDisabledFunc="@(x => x.TotalPRs == 0)" />
                <PropertyColumn Property="x => x.WorkItemId" Title="ID" Sortable="false" Resizable="true"
                                HeaderClass="col-id">
                    <HeaderTemplate>
                        <ColumnFilterHeader Title="ID" Mode="ColumnFilterHeader.ColumnFilterMode.Text"
                                            TextValue="@_idFilter" TextValueChanged="@(v => _idFilter = v)"
                                            OnChanged="OnFilterChanged" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.WorkItemUrl))
                        {
                            <MudLink Href="@context.Item.WorkItemUrl" Target="_blank" Color="Color.Primary"
                                     Typo="Typo.body2" @onclick:stopPropagation="true">
                                <b>@context.Item.WorkItemId</b>
                            </MudLink>
                        }
                        else
                        {
                            <b>@context.Item.WorkItemId</b>
                        }
                        @if (_verifyingReqIds.Contains(context.Item.WorkItemId))
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-1" />
                        }
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Title" Title="Title" Sortable="false" Resizable="true"
                                HeaderClass="col-title" CellClass="col-title-body">
                    <HeaderTemplate>
                        <ColumnFilterHeader Title="Title" Mode="ColumnFilterHeader.ColumnFilterMode.Text"
                                            TextValue="@_titleFilter" TextValueChanged="@(v => _titleFilter = v)"
                                            OnChanged="OnFilterChanged" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <span class="merging-grid-title-cell" title="@context.Item.Title">@context.Item.Title</span>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.WorkItemType" Title="Type" Sortable="false" Resizable="true"
                                HeaderClass="col-type">
                    <HeaderTemplate>
                        <ColumnFilterHeader Title="Type" Options="@AllTypes" Selected="_typeFilter"
                                            OnChanged="OnFilterChanged" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@GetWorkItemTypeColor(context.Item.WorkItemType)">
                            @context.Item.WorkItemType
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.State" Title="State" Sortable="false" Resizable="true"
                                HeaderClass="col-state">
                    <HeaderTemplate>
                        <ColumnFilterHeader Title="State" Options="@AllStates" Selected="_stateFilter"
                                            OnChanged="OnFilterChanged" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@GetStateColor(context.Item.State)">
                            @context.Item.State
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.AssignedTo" Title="Assigned To" Sortable="false" Resizable="true"
                                HeaderClass="col-assigned">
                    <HeaderTemplate>
                        <ColumnFilterHeader Title="Assigned To" Options="@AllAssignees" Selected="_assignedFilter"
                                            OnChanged="OnFilterChanged" />
                    </HeaderTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.TotalPRs" Title="PRs" Sortable="false" Resizable="true"
                                HeaderClass="col-prs" CellStyle="text-align:center">
                    <CellTemplate>
                        @{
                            var prCount = VisiblePrs(context.Item).Count;
                        }
                        @if (prCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@prCount</MudChip>
                        }
                        else
                        {
                            <MudText Color="Color.Tertiary">0</MudText>
                        }
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.TotalCommits" Title="Commits" Sortable="false" Resizable="true"
                                HeaderClass="col-commits" CellStyle="text-align:center">
                    <CellTemplate>
                        @{
                            var commitCount = VisiblePrs(context.Item).Sum(p => p.Commits.Count);
                        }
                        @if (commitCount > 0)
                        {
                            <MudText Color="Color.Info">@commitCount</MudText>
                        }
                        else
                        {
                            <MudText Color="Color.Tertiary">-</MudText>
                        }
                    </CellTemplate>
                </PropertyColumn>
                @if (!string.IsNullOrEmpty(_bundle.TargetBranchName))
                {
                    <TemplateColumn Title="Status"
                                    Sortable="false" Resizable="true"
                                    HeaderClass="col-merged"
                                    CellStyle="text-align:center">
                        <HeaderTemplate>
                            <ColumnFilterHeader Title="Status" Options="@StatusOptions" Selected="_statusFilter"
                                                OnChanged="OnFilterChanged" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.HasAllPRsMergedToTarget == true)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                            }
                            else if (context.Item.HasAllPRsMergedToTarget == false)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                            }
                            else
                            {
                                <MudText Color="Color.Tertiary">-</MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                }
            </Columns>
            <ChildRowContent>
                @{
                    var visiblePrsForRow = VisiblePrs(context.Item);
                }
                @if (visiblePrsForRow.Count > 0)
                {
                    <MudSimpleTable Dense="true" Hover="true" Bordered="true" Class="ma-2"
                                    Style="background: var(--mud-palette-background-grey);">
                        <thead>
                            <tr>
                                <th style="width:40px"></th>
                                <th>PR ID</th>
                                <th>Repository</th>
                                <th>Source Branch</th>
                                <th>Target Branch</th>
                                <th>Status</th>
                                <th>Created By</th>
                                <th>Created</th>
                                <th style="text-align:center">Commits</th>
                                @if (!string.IsNullOrEmpty(_bundle.TargetBranchName))
                                {
                                    <th style="text-align:center">Merged to @_bundle.TargetBranchName?</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pr in visiblePrsForRow)
                            {
                                var prKey = $"{context.Item.WorkItemId}_{pr.PullRequestId}";
                                <tr style="cursor:pointer;" @onclick="@(() => TogglePrExpand(prKey))">
                                    <td>
                                        <MudIcon Icon="@(_expandedPR == prKey ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                 Size="Size.Small" />
                                    </td>
                                    <td>
                                        <MudLink Href="@pr.PullRequestUrl" Target="_blank" Color="Color.Primary">
                                            @pr.PullRequestId
                                        </MudLink>
                                    </td>
                                    <td>@pr.RepositoryName</td>
                                    <td title="@pr.SourceBranch" style="min-width:280px;">
                                        <div class="d-flex align-center gap-1" @onclick:stopPropagation="true">
                                            <code style="max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;">@pr.SourceBranch</code>
                                            <MudTooltip Text="Copy branch name">
                                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                               Size="Size.Small" Color="Color.Default"
                                                               OnClick="@(() => CopyToClipboard(pr.SourceBranch))" />
                                            </MudTooltip>
                                        </div>
                                    </td>
                                    <td><code>@pr.TargetBranch</code></td>
                                    <td>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@GetPrStatusColor(pr.Status)">
                                            @pr.Status
                                        </MudChip>
                                    </td>
                                    <td>@pr.CreatedBy</td>
                                    <td>@pr.CreationDate.ToString("yyyy-MM-dd")</td>
                                    <td style="text-align:center">@pr.Commits.Count</td>
                                    @if (!string.IsNullOrEmpty(_bundle.TargetBranchName))
                                    {
                                        <td style="text-align:center">
                                            @if (pr.IsMergedToTargetBranch == true)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                            }
                                            else if (pr.IsMergedToTargetBranch == false)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                                            }
                                            else
                                            {
                                                <text>-</text>
                                            }
                                        </td>
                                    }
                                </tr>
                                @if (_expandedPR == prKey && pr.Commits.Count > 0)
                                {
                                    <tr>
                                        <td colspan="@(_bundle.TargetBranchName != null ? 10 : 9)" class="pa-0">
                                            <MudSimpleTable Dense="true" Bordered="true" Class="ml-6 my-1"
                                                            Style="background: var(--mud-palette-surface); font-size: 0.85rem;">
                                                <thead>
                                                    <tr>
                                                        <th>Commit SHA</th>
                                                        <th>Message</th>
                                                        <th>Author</th>
                                                        <th>Date</th>
                                                        @if (!string.IsNullOrEmpty(_bundle.TargetBranchName))
                                                        {
                                                            <th style="text-align:center">Merged?</th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var commit in pr.Commits)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div class="d-flex align-center gap-1">
                                                                    @if (!string.IsNullOrEmpty(commit.CommitUrl))
                                                                    {
                                                                        <MudLink Href="@commit.CommitUrl" Target="_blank" Color="Color.Primary"
                                                                                 title="@commit.CommitId">
                                                                            <code>@commit.ShortId</code>
                                                                        </MudLink>
                                                                    }
                                                                    else
                                                                    {
                                                                        <code title="@commit.CommitId">@commit.ShortId</code>
                                                                    }
                                                                    <MudTooltip Text="Copy full commit ID">
                                                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                                                       Size="Size.Small" Color="Color.Default"
                                                                                       OnClick="@(() => CopyToClipboard(commit.CommitId))" />
                                                                    </MudTooltip>
                                                                </div>
                                                            </td>
                                                            <td style="max-width:400px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                                                title="@commit.Message">
                                                                <div class="d-flex align-center gap-1">
                                                                    @if (commit.IsMergeTrackingCommit)
                                                                    {
                                                                        <MudTooltip Text="Auto-generated merge commit — cannot be merged independently, so it's optional.">
                                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                                                     Color="Color.Default" Class="ma-0">Optional</MudChip>
                                                                        </MudTooltip>
                                                                    }
                                                                    <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@commit.Message</span>
                                                                </div>
                                                            </td>
                                                            <td>@commit.Author</td>
                                                            <td>@commit.AuthorDate.ToString("yyyy-MM-dd HH:mm")</td>
                                                            @if (!string.IsNullOrEmpty(_bundle.TargetBranchName))
                                                            {
                                                                <td style="text-align:center">
                                                                    @if (commit.IsMergeTrackingCommit)
                                                                    {
                                                                        <MudTooltip Text="Optional — not required on the target branch.">
                                                                            <MudIcon Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                                                     Color="Color.Default" Size="Size.Small" />
                                                                        </MudTooltip>
                                                                    }
                                                                    else if (commit.IsMergedToTargetBranch == true)
                                                                    {
                                                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                                                    }
                                                                    else if (commit.IsMergedToTargetBranch == false)
                                                                    {
                                                                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <text>-</text>
                                                                    }
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </MudSimpleTable>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </ChildRowContent>
            <PagerContent>
                <MudDataGridPager T="RequirementMergingRow" PageSizeOptions="@(new int[] { 100, 50, 25, 250, 500 })" />
            </PagerContent>
        </MudDataGrid>
    }

    </div>
}

@code {
    // --- State ---
    private List<string> _projects = new();
    private List<string> _teams = new();
    private List<string> _iterations = new();
    private List<(string Id, string Name)> _repos = new();
    private HashSet<string> _myTeams = new(StringComparer.OrdinalIgnoreCase);
    private IEnumerable<string> _selectedRepos = new List<string>();
    private string _selectedProject = "";
    private string _selectedTeam = "";
    private string _currentIterationPath = "";
    private string _targetBranch = "";
    private string _selectedMember = "";
    private string _selectedCreatedBy = "";
    private bool _deliverableOnly = true;
    private bool _orderByFirstCommit;
    private bool _loading;
    private bool _verifying;
    private string? _expandedPR;
    private CodeMergingBundle _bundle = new();

    private List<string> _availableBranches = new();
    private bool _branchesLoading;
    private readonly HashSet<int> _verifyingReqIds = new();

    // --- Per-column header-click filters ---
    private string _idFilter = "";
    private string _titleFilter = "";
    private readonly HashSet<string> _typeFilter = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _stateFilter = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _assignedFilter = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _statusFilter = new(StringComparer.OrdinalIgnoreCase);

    private const string StatusMerged = "Merged";
    private const string StatusNotMerged = "Not merged";
    private const string StatusPending = "Pending";
    private static readonly string[] StatusOptions = { StatusMerged, StatusNotMerged, StatusPending };

    private IEnumerable<string> AllTypes => DistinctValues(r => r.WorkItemType);
    private IEnumerable<string> AllStates => DistinctValues(r => r.State);
    private IEnumerable<string> AllAssignees => DistinctValues(r => r.AssignedTo);

    private IEnumerable<string> DistinctValues(Func<RequirementMergingRow, string> selector) =>
        _bundle.Requirements.Select(selector)
            .Where(v => !string.IsNullOrEmpty(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v, StringComparer.OrdinalIgnoreCase);

    private const string TargetBranchStorageKey = "codeMerging.targetBranch";

    protected override async Task OnInitializedAsync()
    {
        var settings = AzureSettings.Value;
        if (!settings.IsConfigured) return;

        _projects = settings.Projects;

        if (_projects.Count > 0)
        {
            _selectedProject = _projects[0];
            await LoadTeamsAndAutoSelect();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", TargetBranchStorageKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                _targetBranch = saved;
                StateHasChanged();
            }
        }
        catch
        {
            // ignore — localStorage may be unavailable in non-browser context
        }
    }

    private async Task LoadTeamsAndAutoSelect()
    {
        if (string.IsNullOrEmpty(_selectedProject)) return;

        var teamsTask = DevOpsService.GetTeamsAsync(_selectedProject);
        var myTeamsTask = DevOpsService.GetMyTeamsAsync(_selectedProject);
        var iterTask = AdoptionService.GetIterationPathsAsync(_selectedProject);
        var reposTask = MergingService.GetRepositoriesAsync(_selectedProject);
        await Task.WhenAll(teamsTask, myTeamsTask, iterTask, reposTask);

        _teams = teamsTask.Result;
        _myTeams = new HashSet<string>(myTeamsTask.Result, StringComparer.OrdinalIgnoreCase);
        _iterations = iterTask.Result;
        // Sort repos: primary repos first, then others alphabetically
        var primaryRepoNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { "CasepointARA", "FX-CPFOIA-Migration" };
        var primaryRepos = reposTask.Result
            .Where(r => primaryRepoNames.Contains(r.Name))
            .OrderBy(r => r.Name)
            .ToList();
        var otherRepos = reposTask.Result
            .Where(r => !primaryRepoNames.Contains(r.Name))
            .OrderBy(r => r.Name)
            .ToList();
        _repos = primaryRepos.Concat(otherRepos).ToList();

        // Default: only select primary repos
        _selectedRepos = primaryRepos.Select(r => r.Name).ToList();

        if (_myTeams.Count > 0)
        {
            _selectedTeam = _myTeams.First();
            var iterPath = await DevOpsService.GetCurrentIterationAsync(_selectedProject, _selectedTeam);
            if (!string.IsNullOrEmpty(iterPath))
            {
                _currentIterationPath = iterPath;
                await LoadData();
            }
        }

        StateHasChanged();
    }

    private async Task OnProjectChanged(string project)
    {
        _selectedProject = project;
        _selectedTeam = "";
        _currentIterationPath = "";
        _bundle = new();
        await LoadTeamsAndAutoSelect();
    }

    private async Task OnTeamChanged(string team)
    {
        _selectedTeam = team;
        _currentIterationPath = "";
        _selectedMember = "";
        _selectedCreatedBy = "";
        _bundle = new();

        if (string.IsNullOrEmpty(_selectedProject) || string.IsNullOrEmpty(_selectedTeam)) return;

        try
        {
            var iterPath = await DevOpsService.GetCurrentIterationAsync(_selectedProject, _selectedTeam);
            if (!string.IsNullOrEmpty(iterPath))
            {
                _currentIterationPath = iterPath;
                await LoadData();
            }
            else
            {
                Snackbar.Add("Could not detect current iteration.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }

        StateHasChanged();
    }

    private async Task OnIterationChanged(string iteration)
    {
        _currentIterationPath = iteration;
        _selectedMember = "";
        _selectedCreatedBy = "";
        _bundle = new();
        await LoadData();
    }

    private void OnReposChanged(IEnumerable<string> repos)
    {
        _selectedRepos = repos;
    }

    private async Task LoadData()
    {
        if (string.IsNullOrEmpty(_currentIterationPath)) return;

        _loading = true;
        _expandedPR = null;
        _verifyingReqIds.Clear();
        ClearColumnFilters();
        StateHasChanged();

        try
        {
            var repoNames = _selectedRepos?.ToList() ?? new List<string>();
            var bundleTask = MergingService.GetMergingDataAsync(
                _selectedProject, _selectedTeam, _currentIterationPath,
                repoNames, _deliverableOnly, GetRepoTargetBranchFilters());

            // Kick off branch fetch in parallel so the dropdown is ready as soon as data loads.
            _branchesLoading = true;
            var branchesTask = MergingService.GetBranchesAsync(_selectedProject, repoNames);

            await Task.WhenAll(bundleTask, branchesTask);

            _bundle = bundleTask.Result;
            _availableBranches = branchesTask.Result;
            _branchesLoading = false;

            if (!string.IsNullOrEmpty(_bundle.ErrorMessage))
                Snackbar.Add(_bundle.ErrorMessage, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            _bundle = new() { ErrorMessage = ex.Message };
        }
        finally
        {
            _loading = false;
            _branchesLoading = false;
            StateHasChanged();
        }
    }

    private async Task VerifyMerge()
    {
        if (string.IsNullOrEmpty(_targetBranch) || _bundle.Requirements.Count == 0) return;

        _verifying = true;
        StateHasChanged();

        try
        {
            await MergingService.VerifyMergeToTargetAsync(_bundle, _selectedProject, _targetBranch);
            Snackbar.Add($"Merge verification complete: {_bundle.MergedToTargetCount} merged, {_bundle.NotMergedToTargetCount} not merged.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error verifying: {ex.Message}", Severity.Error);
        }
        finally
        {
            _verifying = false;
            StateHasChanged();
        }
    }

    private void OnMemberChanged(string member)
    {
        _selectedMember = member ?? "";
        _expandedPR = null;
    }

    private void OnCreatedByChanged(string createdBy)
    {
        _selectedCreatedBy = createdBy ?? "";
        _expandedPR = null;
    }

    /// <summary>Distinct PR authors across all requirements, sorted for the dropdown.</summary>
    private IEnumerable<string> AllPrCreators =>
        _bundle.Requirements
            .SelectMany(r => r.PullRequests)
            .Select(p => p.CreatedBy)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase);

    /// <summary>PRs on this row that should be shown given the current Created By filter.</summary>
    private List<PullRequestInfo> VisiblePrs(RequirementMergingRow row)
    {
        if (string.IsNullOrEmpty(_selectedCreatedBy))
            return row.PullRequests;
        return row.PullRequests
            .Where(p => string.Equals(p.CreatedBy, _selectedCreatedBy, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private Task<IEnumerable<string>> SearchBranches(string? value, CancellationToken ct)
    {
        if (_availableBranches.Count == 0)
            return Task.FromResult(Enumerable.Empty<string>());

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_availableBranches.Take(50));

        var lower = value.Trim();
        return Task.FromResult(_availableBranches
            .Where(b => b.Contains(lower, StringComparison.OrdinalIgnoreCase))
            .Take(50));
    }

    private async Task OnTargetBranchChanged(string? branch)
    {
        _targetBranch = branch ?? "";

        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", TargetBranchStorageKey, _targetBranch);
        }
        catch { /* ignore */ }

        if (string.IsNullOrEmpty(_targetBranch))
        {
            // Clear prior verification state so the "Merged?" column hides cleanly.
            _bundle.TargetBranchName = null;
            foreach (var pr in _bundle.Requirements.SelectMany(r => r.PullRequests))
                pr.IsMergedToTargetBranch = null;
            _bundle.MergedToTargetCount = 0;
            _bundle.NotMergedToTargetCount = 0;
            StateHasChanged();
        }
    }

    private async Task OnRowClick(DataGridRowClickEventArgs<RequirementMergingRow> args)
    {
        var req = args.Item;
        if (req == null || req.TotalPRs == 0) return;
        if (string.IsNullOrWhiteSpace(_targetBranch)) return;
        if (_verifyingReqIds.Contains(req.WorkItemId)) return;

        _verifyingReqIds.Add(req.WorkItemId);
        StateHasChanged();
        try
        {
            await MergingService.VerifyMergeForRequirementAsync(
                _bundle, _selectedProject, _targetBranch, req.WorkItemId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Refresh failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _verifyingReqIds.Remove(req.WorkItemId);
            StateHasChanged();
        }
    }

    private List<RequirementMergingRow> FilteredRequirements()
    {
        IEnumerable<RequirementMergingRow> query = _bundle.Requirements.Where(MatchesColumnFilters);

        if (!string.IsNullOrEmpty(_selectedMember))
            query = query.Where(r => string.Equals(r.AssignedTo, _selectedMember, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(_selectedCreatedBy))
            query = query.Where(r => r.PullRequests.Any(p =>
                string.Equals(p.CreatedBy, _selectedCreatedBy, StringComparison.OrdinalIgnoreCase)));

        if (_orderByFirstCommit)
        {
            // Items without any commits go to the end so the timeline starts with real activity.
            query = query
                .OrderBy(r => r.FirstCommitDate == null)
                .ThenBy(r => r.FirstCommitDate ?? DateTime.MaxValue)
                .ThenBy(r => r.WorkItemId);
        }

        return query.ToList();
    }

    /// <summary>Applies all per-column header-click filters to a single row (AND across columns).</summary>
    private bool MatchesColumnFilters(RequirementMergingRow r)
    {
        if (!string.IsNullOrWhiteSpace(_idFilter) &&
            !r.WorkItemId.ToString().Contains(_idFilter.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_titleFilter) &&
            !r.Title.Contains(_titleFilter.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        if (_typeFilter.Count > 0 && !_typeFilter.Contains(r.WorkItemType)) return false;
        if (_stateFilter.Count > 0 && !_stateFilter.Contains(r.State)) return false;
        if (_assignedFilter.Count > 0 && !_assignedFilter.Contains(r.AssignedTo)) return false;
        if (_statusFilter.Count > 0 && !_statusFilter.Contains(StatusLabel(r))) return false;

        return true;
    }

    private static string StatusLabel(RequirementMergingRow r) => r.HasAllPRsMergedToTarget switch
    {
        true => StatusMerged,
        false => StatusNotMerged,
        _ => StatusPending
    };

    private void OnFilterChanged()
    {
        _expandedPR = null;
        StateHasChanged();
    }

    private void ClearColumnFilters()
    {
        _idFilter = "";
        _titleFilter = "";
        _typeFilter.Clear();
        _stateFilter.Clear();
        _assignedFilter.Clear();
        _statusFilter.Clear();
    }

    private void TogglePrExpand(string prKey)
    {
        _expandedPR = _expandedPR == prKey ? null : prKey;
    }

    private static Color GetWorkItemTypeColor(string type) => type switch
    {
        "Bug" => Color.Error,
        "Change Request" => Color.Warning,
        _ => Color.Info
    };

    private static Color GetStateColor(string state) => state.ToLower() switch
    {
        "closed" => Color.Success,
        "resolved" => Color.Warning,
        "active" => Color.Info,
        "new" => Color.Default,
        "proposed" => Color.Default,
        _ => Color.Default
    };

    private static Color GetPrStatusColor(string status) => status.ToLower() switch
    {
        "completed" => Color.Success,
        "active" => Color.Info,
        "abandoned" => Color.Default,
        _ => Color.Default
    };

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add($"Copied: {text[..Math.Min(text.Length, 20)]}", Severity.Success,
                config => config.VisibleStateDuration = 1000);
        }
        catch
        {
            Snackbar.Add("Copy failed", Severity.Warning);
        }
    }

    /// <summary>
    /// Returns target branch filter per repo:
    /// FX-CPFOIA-Migration → main, CasepointARA → dev-qa-net8
    /// </summary>
    private Dictionary<string, string> GetRepoTargetBranchFilters()
    {
        return new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["FX-CPFOIA-Migration"] = "main",
            ["CasepointARA"] = "dev-qa-net8"
        };
    }

    private async Task ExportToExcel()
    {
        try
        {
            using var workbook = new XLWorkbook();

            // --- Sheet 1: Summary ---
            var ws = workbook.Worksheets.Add("Code Merging");
            var headers = new List<string>
            {
                "Req ID", "Title", "Type", "State", "Assigned To",
                "PR ID", "Repository", "Source Branch", "Target Branch",
                "PR Status", "PR Created By", "PR Created Date",
                "Commit SHA", "Commit Message", "Commit Author", "Commit Date"
            };

            var hasVerification = !string.IsNullOrEmpty(_bundle.TargetBranchName);
            if (hasVerification)
            {
                headers.Add($"PR Merged to {_bundle.TargetBranchName}?");
                headers.Add($"Commit Merged to {_bundle.TargetBranchName}?");
            }

            for (int i = 0; i < headers.Count; i++)
                ws.Cell(1, i + 1).Value = headers[i];

            // Style header
            var headerRange = ws.Range(1, 1, 1, headers.Count);
            headerRange.Style.Font.Bold = true;
            headerRange.Style.Fill.BackgroundColor = XLColor.FromHtml("#1a1a2e");
            headerRange.Style.Font.FontColor = XLColor.White;
            headerRange.Style.Alignment.WrapText = true;

            int row = 2;
            foreach (var req in FilteredRequirements())
            {
                var reqPrs = VisiblePrs(req);
                if (reqPrs.Count == 0)
                {
                    // Requirement with no PRs (or all PRs filtered out) - still show the requirement row
                    ws.Cell(row, 1).Value = req.WorkItemId;
                    ws.Cell(row, 2).Value = req.Title;
                    ws.Cell(row, 3).Value = req.WorkItemType;
                    ws.Cell(row, 4).Value = req.State;
                    ws.Cell(row, 5).Value = req.AssignedTo;
                    ColorStateCell(ws.Cell(row, 4), req.State);
                    ColorTypeCell(ws.Cell(row, 3), req.WorkItemType);
                    row++;
                }
                else
                {
                    foreach (var pr in reqPrs)
                    {
                        if (pr.Commits.Count == 0)
                        {
                            // PR with no commits
                            ws.Cell(row, 1).Value = req.WorkItemId;
                            ws.Cell(row, 2).Value = req.Title;
                            ws.Cell(row, 3).Value = req.WorkItemType;
                            ws.Cell(row, 4).Value = req.State;
                            ws.Cell(row, 5).Value = req.AssignedTo;
                            ws.Cell(row, 6).Value = pr.PullRequestId;
                            ws.Cell(row, 7).Value = pr.RepositoryName;
                            ws.Cell(row, 8).Value = pr.SourceBranch;
                            ws.Cell(row, 9).Value = pr.TargetBranch;
                            ws.Cell(row, 10).Value = pr.Status;
                            ws.Cell(row, 11).Value = pr.CreatedBy;
                            ws.Cell(row, 12).Value = pr.CreationDate.ToString("yyyy-MM-dd");
                            ColorStateCell(ws.Cell(row, 4), req.State);
                            ColorTypeCell(ws.Cell(row, 3), req.WorkItemType);
                            ColorPrStatusCell(ws.Cell(row, 10), pr.Status);
                            if (hasVerification)
                            {
                                ws.Cell(row, 17).Value = PrMergedText(pr);
                                ws.Cell(row, 18).Value = "-";
                            }
                            row++;
                        }
                        else
                        {
                            foreach (var commit in pr.Commits)
                            {
                                ws.Cell(row, 1).Value = req.WorkItemId;
                                ws.Cell(row, 2).Value = req.Title;
                                ws.Cell(row, 3).Value = req.WorkItemType;
                                ws.Cell(row, 4).Value = req.State;
                                ws.Cell(row, 5).Value = req.AssignedTo;
                                ws.Cell(row, 6).Value = pr.PullRequestId;
                                ws.Cell(row, 7).Value = pr.RepositoryName;
                                ws.Cell(row, 8).Value = pr.SourceBranch;
                                ws.Cell(row, 9).Value = pr.TargetBranch;
                                ws.Cell(row, 10).Value = pr.Status;
                                ws.Cell(row, 11).Value = pr.CreatedBy;
                                ws.Cell(row, 12).Value = pr.CreationDate.ToString("yyyy-MM-dd");
                                ws.Cell(row, 13).Value = commit.CommitId;
                                ws.Cell(row, 14).Value = commit.Message;
                                ws.Cell(row, 15).Value = commit.Author;
                                ws.Cell(row, 16).Value = commit.AuthorDate.ToString("yyyy-MM-dd HH:mm");
                                ColorStateCell(ws.Cell(row, 4), req.State);
                                ColorTypeCell(ws.Cell(row, 3), req.WorkItemType);
                                ColorPrStatusCell(ws.Cell(row, 10), pr.Status);
                                if (hasVerification)
                                {
                                    ws.Cell(row, 17).Value = PrMergedText(pr);
                                    ws.Cell(row, 18).Value = CommitMergedText(commit);
                                }
                                row++;
                            }
                        }
                    }
                }
            }

            // Auto-fit but set min widths for key columns
            ws.Columns().AdjustToContents();
            ws.Column(2).Width = Math.Max(ws.Column(2).Width, 40);  // Title
            ws.Column(8).Width = Math.Max(ws.Column(8).Width, 50);  // Source Branch (full, no truncation)
            ws.Column(13).Width = Math.Max(ws.Column(13).Width, 42); // Full commit SHA
            ws.Column(14).Width = Math.Max(ws.Column(14).Width, 50); // Commit Message

            // Freeze header row
            ws.SheetView.FreezeRows(1);

            using var ms = new MemoryStream();
            workbook.SaveAs(ms);
            var bytes = ms.ToArray();

            var fileName = $"CodeMerging_{_selectedTeam.Replace(" ", "_")}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);

            Snackbar.Add("Excel exported!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
    }

    private static string PrMergedText(PullRequestInfo pr) =>
        pr.IsMergedToTargetBranch == true ? "Yes"
        : pr.IsMergedToTargetBranch == false ? "No"
        : "-";

    private static string CommitMergedText(CommitInfo commit) =>
        commit.IsMergeTrackingCommit ? "Optional"
        : commit.IsMergedToTargetBranch == true ? "Yes"
        : commit.IsMergedToTargetBranch == false ? "No"
        : "-";

    private static void ColorStateCell(IXLCell cell, string state)
    {
        var (bg, fg) = state.ToLower() switch
        {
            "closed" => (XLColor.FromHtml("#2e7d32"), XLColor.White),
            "resolved" => (XLColor.FromHtml("#f57c00"), XLColor.White),
            "active" => (XLColor.FromHtml("#1565c0"), XLColor.White),
            "proposed" => (XLColor.FromHtml("#757575"), XLColor.White),
            _ => (XLColor.NoColor, XLColor.Black)
        };
        if (bg != XLColor.NoColor)
        {
            cell.Style.Fill.BackgroundColor = bg;
            cell.Style.Font.FontColor = fg;
        }
    }

    private static void ColorTypeCell(IXLCell cell, string type)
    {
        var bg = type switch
        {
            "Bug" => XLColor.FromHtml("#c62828"),
            "Change Request" => XLColor.FromHtml("#ef6c00"),
            _ => XLColor.FromHtml("#1565c0")
        };
        cell.Style.Fill.BackgroundColor = bg;
        cell.Style.Font.FontColor = XLColor.White;
    }

    private static void ColorPrStatusCell(IXLCell cell, string status)
    {
        if (status.Equals("completed", StringComparison.OrdinalIgnoreCase))
        {
            cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#2e7d32");
            cell.Style.Font.FontColor = XLColor.White;
        }
    }

    private static string TruncateIteration(string path)
    {
        if (string.IsNullOrEmpty(path)) return "";
        var parts = path.Split('\\');
        return parts.Length > 2 ? string.Join("\\", parts[^2..]) : path;
    }
}
