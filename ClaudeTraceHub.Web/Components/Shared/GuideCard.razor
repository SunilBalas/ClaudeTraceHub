@if (IsVisible)
{
    <MudPaper Elevation="1" Class="pa-4 mb-3 guide-card" Style="border-radius: 10px;">
        <div class="d-flex align-center mb-1">
            <MudText Typo="Typo.h6" Class="guide-card-title">@Title</MudText>
            @if (!string.IsNullOrEmpty(Pill))
            {
                <MudChip T="string" Size="Size.Small" Color="PillColor" Variant="Variant.Outlined" Class="ml-2">@Pill</MudChip>
            }
        </div>
        @if (!string.IsNullOrEmpty(Desc))
        {
            <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-3">@Desc</MudText>
        }
        @ChildContent
    </MudPaper>
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Desc { get; set; } = "";
    [Parameter] public string? Pill { get; set; }
    [Parameter] public Color PillColor { get; set; } = Color.Default;
    [Parameter] public string SearchTags { get; set; } = "";
    [Parameter] public string Search { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsVisible
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Search)) return true;
            var term = Search.Trim().ToLowerInvariant();
            var haystack = $"{Title} {Desc} {SearchTags}".ToLowerInvariant();
            return haystack.Contains(term);
        }
    }
}
