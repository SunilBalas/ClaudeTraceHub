@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@using System.Reflection

<div class="nav-brand">
    <div class="nav-brand-title">
        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Medium" />
        Claude TraceHub
    </div>
    <div class="nav-brand-subtitle">Conversation Tracker</div>
</div>

<MudNavMenu>
    @foreach (var key in _orderedKeys)
    {
        if (_items.TryGetValue(key, out var item))
        {
            <MudNavLink Href="@item.Href" Match="@item.Match" Icon="@item.Icon"
                        Disabled="@(item.RequiresSetupGate && RequiresSetup)">
                @item.Label
            </MudNavLink>
        }
    }
    <MudDivider Class="my-2" />
    <MudNavLink Href="@_settings.Href" Icon="@_settings.Icon">
        @_settings.Label
    </MudNavLink>
</MudNavMenu>

<div class="nav-footer">
    <MudText Typo="Typo.caption" Color="Color.Tertiary">v@(_version) | @_copyright</MudText>
</div>

@code {
    [Parameter] public bool RequiresSetup { get; set; }

    private static readonly Assembly _assembly = Assembly.GetExecutingAssembly();

    private string _version = (_assembly
        .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
        ?? _assembly.GetName().Version?.ToString(3)
        ?? "0.0.0").Split('+')[0];

    private string _copyright = _assembly
        .GetCustomAttribute<AssemblyCopyrightAttribute>()?.Copyright
        ?? $"\u00a9 {DateTime.Now.Year}";

    private record NavItem(string Href, string Icon, string Label, NavLinkMatch Match, bool RequiresSetupGate);

    private static readonly Dictionary<string, NavItem> _items = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Dashboard"] = new("/", Icons.Material.Filled.Dashboard, "Dashboard", NavLinkMatch.All, true),
        ["Projects"] = new("/projects", Icons.Material.Filled.Folder, "Projects", NavLinkMatch.Prefix, true),
        ["UsageStatistics"] = new("/usage-stats", Icons.Material.Filled.Analytics, "Usage Statistics", NavLinkMatch.Prefix, true),
        ["TfsExplorer"] = new("/tfs-explorer", Icons.Material.Filled.FindInPage, "TFS Explorer", NavLinkMatch.Prefix, true),
        ["AiAdoption"] = new("/ai-adoption", Icons.Material.Filled.GroupWork, "AI Adoption", NavLinkMatch.Prefix, true),
        ["TfsEfficiency"] = new("/tfs-efficiency", Icons.Material.Filled.Timer, "TFS Efficiency", NavLinkMatch.Prefix, true),
        ["CodeMergingSheet"] = new("/code-merging", Icons.Material.Filled.MergeType, "Code Merging Sheet", NavLinkMatch.Prefix, true),
        ["PlanningVerification"] = new("/planning-verification", Icons.Material.Filled.FactCheck, "Planning Verification", NavLinkMatch.Prefix, true),
        ["BranchCreation"] = new("/branch-creation", Icons.Material.Filled.CallSplit, "Branch Creation", NavLinkMatch.Prefix, false),
        ["GitGuide"] = new("/git-guide", Icons.Material.Filled.MenuBook, "Git Guide", NavLinkMatch.Prefix, false),
    };

    private static readonly NavItem _settings =
        new("/settings", Icons.Material.Filled.Settings, "Settings", NavLinkMatch.Prefix, false);

    private string[] _orderedKeys = Array.Empty<string>();

    protected override void OnInitialized()
    {
        var configured = Configuration.GetSection("NavMenu:Order").Get<string[]>() ?? Array.Empty<string>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var ordered = new List<string>();

        foreach (var key in configured)
        {
            if (_items.ContainsKey(key) && seen.Add(key))
                ordered.Add(key);
        }
        // Append any tabs missing from config so nothing disappears on misconfiguration.
        foreach (var key in _items.Keys)
        {
            if (seen.Add(key))
                ordered.Add(key);
        }

        _orderedKeys = ordered.ToArray();
    }
}
